# =====================================================
# JogaTek Production .htaccess
# =====================================================

DirectoryIndex index.php

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS + Remove WWW
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.jogatek\.com$ [NC]
    RewriteRule ^(.*)$ https://jogatek.com/$1 [R=301,L]

    # Allow robots.txt & rewrite sitemap.xml to sitemap.php
    RewriteRule ^robots\.txt$ - [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Allow assets folder
    RewriteRule ^assets/ - [L]

    # Existing files
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Existing directories
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Homepage
    RewriteRule ^$ index.php [L]

    # Clean URLs
    RewriteCond %{DOCUMENT_ROOT}/$1/index.php -f
    RewriteRule ^(.+?)/?$ $1/index.php [L]

    # Custom 404
    RewriteRule ^.*$ 404/index.php [L]
</IfModule>

# Custom 404 Page
ErrorDocument 404 /404/index.php

# Protect Sensitive Files
<FilesMatch "^(config\.php|\.env|composer\.json|composer\.lock)$">
    Require all denied
</FilesMatch>

# Execute sitemap.xml as PHP
<Files "sitemap.xml">
    SetHandler application/x-httpd-php
</Files>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Browser Cache
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    ExpiresDefault "access plus 7 days"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>